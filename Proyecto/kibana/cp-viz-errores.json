{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": {
      "%context%": true,
      "%timefield%": "fecha",
      "index": "cp-predicciones",
      "body": {
        "size": 0,
        "aggs": {
          "valores": {
            "terms": {
              "field": "modelo",
              "size": 2
            },
            "aggs": {
              "mae": {
                "avg": {
                  "field": "error_absoluto_m2"
                }
              }
            }
          }
        }
      }
    },
    "format": {
      "property": "aggregations.valores.buckets"
    }
  },
  "mark": {
    "type": "bar",
    "color": "#176D8A",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "key",
      "type": "nominal",
      "title": "Modelo"
    },
    "y": {
      "field": "mae.value",
      "type": "quantitative",
      "title": "MAE (m²)",
      "axis": {
        "format": "~s"
      }
    }
  },
  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}
